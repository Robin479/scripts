# :command.usage
beam_shop_covers_import_usage() {
  printf "beam-shop covers import - Manually register an already-on-disk cover for one product -- for when the shop's own copy is unreachable (e.g. a 404 on what should be its image url) but you already have the real cover some other way\n\n"

  printf "%s\n" "Usage:"
  printf "  beam-shop covers import IMAGE_FILE [OPTIONS]\n"
  printf "  beam-shop covers import --help | -h\n"
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "Options:"

    # :command.usage_flags
    # :flag.usage
    printf "  %s\n" "--product PRODUCT_ID"
    printf "    Shop product id (from the product's own URL, or from an earlier 'covers\n    fetch' error naming it) -- required together with --category/--title, as an\n    alternative to --series/--item\n"
    echo

    # :flag.usage
    printf "  %s\n" "--category CATEGORY_ID"
    printf "    Which shop category this product belongs to (see 'categories list') --\n    required together with --product/--title\n"
    echo

    # :flag.usage
    printf "  %s\n" "--title TITLE"
    printf "    The product's title, exactly as shown on the shop -- required together with\n    --product/--category\n"
    echo

    # :flag.usage
    printf "  %s\n" "--series SERIES_ID"
    printf "    Resolve --product/--category/--title automatically from an already-cached\n    record at this series + --item, instead of giving them directly -- only\n    works for a 'broken' 'series audit' finding (record intact, image file\n    gone); a 'missing' one (never fetched at all) has no id to resolve and needs\n    the --product form\n"
    echo

    # :flag.usage
    printf "  %s\n" "--item ITEM_NUMBER"
    printf "    Series item number to resolve via --series (see above)\n"
    echo

