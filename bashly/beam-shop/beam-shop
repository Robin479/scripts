# :command.function
beam_shop_config_get_command() {

  # src/config_get_command.sh
  : # keeps the shellcheck directive below scoped to one line, not file-wide
  # shellcheck disable=SC2154 # args is bashly's global associative array
  key="${args[key]}"

  value="$(bs::config_get "$key" "")"
  if [[ -n "$value" ]]; then
    echo "$value"
  else
    default="$(bs::config_default_display "$key")"
    if [[ -n "$default" ]]; then
      echo "$default (default)"
    else
      echo "(not set, no known default)"
    fi
  fi

}

# :command.function
beam_shop_config_set_command() {

  # src/config_set_command.sh
  : # keeps the shellcheck directive below scoped to one line, not file-wide
  # shellcheck disable=SC2154 # args is bashly's global associative array
  key="${args[key]}"
  value="${args[value]}"

  if ! bs::config_is_known_key "$key"; then
    echo "note: '$key' is not a setting beam-shop itself reads -- see 'beam-shop config list'" >&2
  fi

  bs::config_set "$key" "$value"
  echo "$key = $value"

}

# :command.function
beam_shop_config_unset_command() {

  # src/config_unset_command.sh
  : # keeps the shellcheck directive below scoped to one line, not file-wide
  # shellcheck disable=SC2154 # args is bashly's global associative array
  all="${args[--all]:-}"
  keys="${args[key]:-}"

  if [[ -n "$all" && -n "$keys" ]]; then
    echo "error: --all and specific keys are mutually exclusive" >&2
    exit 1
  fi

  if [[ -z "$all" && -z "$keys" ]]; then
    echo "error: give one or more setting names, or --all" >&2
    exit 1
  fi

  if [[ -n "$all" ]]; then
    # shellcheck disable=SC2207 # bs::config_keys' own output is a plain newline-separated list, one key per line, none of them containing whitespace
    set_keys=($(bs::config_keys))
    if [[ "${#set_keys[@]}" -eq 0 ]]; then
      echo "No settings are currently set."
      exit 0
    fi
    keys="${set_keys[*]}"
  fi

  ok=0
  # shellcheck disable=SC2086 # word-splitting is exactly what's wanted — keys is either bashly's own space-separated repeatable-arg string, or built the same way just above for --all
  for key in $keys; do
    bs::config_del "$key"
    echo "$key -> unset (reverts to its default, if any)"
    ok=$((ok + 1))
  done

  echo "Unset $ok setting(s)."

}

# :command.parse_requirements
parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        beam_shop_usage
        exit
        ;;

      # :flag.case
      --data-path)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--data-path']="$2"
          shift
          shift
        else
          printf "%s\n" "--data-path requires an argument: --data-path PATH" >&2
          exit 1
        fi
        ;;

      # :flag.case
      --offline)

        # :flag.case_no_arg
        args['--offline']=1
        shift
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.command_filter
  action=${1:-}

  case $action in
    -*) ;;

    completions)
      action="completions"
      shift
      beam_shop_completions_parse_requirements "$@"
      shift $#
      ;;

    categories)
      action="categories"
      shift
      beam_shop_categories_parse_requirements "$@"
      shift $#
      ;;

    series)
      action="series"
      shift
      beam_shop_series_parse_requirements "$@"
      shift $#
      ;;

    covers)
      action="covers"
      shift
      beam_shop_covers_parse_requirements "$@"
      shift $#
      ;;

    config)
      action="config"
      shift
      beam_shop_config_parse_requirements "$@"
      shift $#
      ;;

    # :command.command_fallback
    "")
      beam_shop_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

