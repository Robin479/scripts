# :command.parse_requirements
parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        remote_exec_usage
        exit
        ;;

      # :flag.case
      --host)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--host']="$2"
          shift
          shift
        else
          printf "%s\n" "--host requires an argument: --host HOST" >&2
          exit 1
        fi
        ;;

      # :flag.case
      --root)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--root']="$2"
          shift
          shift
        else
          printf "%s\n" "--root requires an argument: --root ROOT" >&2
          exit 1
        fi
        ;;

      # :flag.case
      --dry-run | -n)

        # :flag.case_no_arg
        args['--dry-run']=1
        shift
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.environment_variables_filter
  # :command.environment_variables_default
  export REMOTE_EXEC_HOST="${REMOTE_EXEC_HOST:-kiwi}"
  export REMOTE_EXEC_ROOT="${REMOTE_EXEC_ROOT:-/tmp/remote-exec}"

  env_var_names+=("REMOTE_EXEC_HOST")
  env_var_names+=("REMOTE_EXEC_ROOT")

  # :command.command_filter
  action=${1:-}

  case $action in

    completions)
      action="completions"
      shift
      remote_exec_completions_parse_requirements "$@"
      shift $#
      ;;

    mvn)
      action="mvn"
      shift
      remote_exec_mvn_parse_requirements "$@"
      shift $#
      ;;

    exec)
      action="exec"
      shift
      remote_exec_exec_parse_requirements "$@"
      shift $#
      ;;

    clean)
      action="clean"
      shift
      remote_exec_clean_parse_requirements "$@"
      shift $#
      ;;

    # :command.command_fallback
    "")
      remote_exec_usage >&2
      exit 1
      ;;

    *)
      action="exec"
      remote_exec_exec_parse_requirements "$@"
      shift $#
      ;;

  esac

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

# :command.parse_requirements
remote_exec_completions_parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        remote_exec_completions_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.command_filter
  action="completions"

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        # :argument.case
        if [[ -z ${args['shell']+x} ]]; then
          args['shell']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  # :command.default_assignments
  [[ -n ${args['shell']:-} ]] || args['shell']="bash"

  # :command.whitelist_filter
  if [[ -n ${args['shell']:-} ]] && [[ ! ${args['shell']:-} =~ ^(bash)$ ]]; then
    printf "%s\n" "shell must be one of: bash" >&2
    exit 1
  fi

}

