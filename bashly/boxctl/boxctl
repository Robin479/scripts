# :command.initialize
initialize() {
  declare -g version="0.0.0"
  set -e

}

# :command.run
run() {
  # :command.globals
  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "completions") boxctl_completions_command ;;
    "drop-caches") boxctl_drop_caches_command ;;
    "install") boxctl_install_command ;;
    "install calibre") boxctl_install_calibre_command ;;
    "install xidel") boxctl_install_xidel_command ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  initialize
  run "$@"
fi
