# :command.user_hooks
before_hook() {
  # src/before.sh
  gr::init_cookie_jar

}

# :command.initialize
initialize() {
  declare -g version="0.1.0"
  set -e

}

# :command.run
run() {
  # :command.globals
  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"
  before_hook

  case "$action" in
    "auth") goodreads_auth_command ;;
    "auth import") goodreads_auth_import_command ;;
    "auth status") goodreads_auth_status_command ;;
    "auth list") goodreads_auth_list_command ;;
    "auth switch") goodreads_auth_switch_command ;;
    "auth logout") goodreads_auth_logout_command ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  initialize
  run "$@"
fi
